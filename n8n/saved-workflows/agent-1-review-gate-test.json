      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const decision=$input.first().json;const draft=$('Rank Revenue Peers').first().json;\nconst approved=decision.Decision==='Approve'&&decision['Sources verified']==='Yes'&&draft.target.usable&&draft.selected_count>0&&(draft.shortfall===0||decision['Accept fewer than five']==='Yes');\nreturn [{json:{...draft,status:approved?'approved':decision.Decision==='Reject'?'rejected':'revision_required',\napproved,review:{decision:decision.Decision,sources_verified:decision['Sources verified']==='Yes',accept_shortfall:decision['Accept fewer than five']==='Yes',notes:decision['Review notes']||''},\ncompanies_for_agent2:approved?[{company:draft.company,is_target:true},...draft.selected_peers.map(p=>({company:p.company,is_target:false,source_url:p.source_url}))]:[]}}];"
      },
